{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "unblurt",
  "version": "0.1.0",
  "identifier": "app.unblurt.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "popover",
        "title": "unblurt",
        "width": 640,
        "height": 320,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "visible": false,
        "center": true,
        "visibleOnAllWorkspaces": true
      },
      {
        "label": "plate",
        "title": "unblurt plate",
        "width": 16,
        "height": 176,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "visible": false,
        "focusable": false,
        "focus": false,
        "acceptFirstMouse": true,
        "dragDropEnabled": false,
        "visibleOnAllWorkspaces": true
      },
      {
        "label": "settings",
        "title": "unblurt",
        "width": 540,
        "height": 720,
        "resizable": false,
        "visible": false,
        "center": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "messy thoughts. clear writing.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0"
    }
  }
}
